  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "db:generate": "bun --env-file=../.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate --config=drizzle.config.ts",
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@ai-sdk/google-vertex": "3.0.164",
    "ai": "6.0.264",
    "@copilotkit/runtime": "1.69.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "cel-js": "^0.8.2",
    "cron-parser": "^5",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "10.9.1",
    "hono": "^4.10.0",
    "jose": "6.2.10",
    "postgres": "^3.4.9",
    "rxjs": "7.8.1",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@ai-sdk/openai": "3.0.99",
    "@copilotkit/aimock": "1.39.0",
    "drizzle-kit": "^0.31.10",
    "eventsource": "3.0.7"
  }
}
